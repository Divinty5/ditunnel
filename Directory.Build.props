<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <AnalysisLevel>latest</AnalysisLevel>
    <Product>Di-Tunnel</Product>
    <Version>0.4.24</Version>
    <Company>Di Vinty Interactive</Company>
    <Authors>Di Vinty Interactive</Authors>
    <Copyright>Copyright © 2026 Di Vinty Interactive</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Divinty5/ditunnel</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DITUNNEL_BUILD_ROOT)' != ''">
    <BaseIntermediateOutputPath>$(DITUNNEL_BUILD_ROOT)\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(DITUNNEL_BUILD_ROOT)\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
