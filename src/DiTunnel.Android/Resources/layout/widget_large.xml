<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
  <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Di-Tunnel" android:textColor="#C3A9ED" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="84dp" android:orientation="horizontal" android:gravity="center_vertical">
    <ImageView android:id="@+id/widget_power" android:layout_width="84dp" android:layout_height="84dp" android:scaleType="fitCenter" android:src="@drawable/ic_vpn_tile" android:contentDescription="Di-Tunnel" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingLeft="8dp">
      <TextView android:id="@+id/widget_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDE6FF" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" android:text="@string/widget_select_server" />
      <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C3A9ED" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:text="@string/widget_disconnected" />
      <TextView android:id="@+id/widget_latency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="2dp" android:paddingBottom="2dp" android:textSize="12sp" android:textStyle="bold" android:visibility="gone" android:background="@drawable/widget_latency_dark" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#C3A9ED" android:textSize="14sp" android:text="@string/widget_select_server" />
  <ListView android:id="@+id/widget_servers" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#66584178" android:dividerHeight="1dp" />
</LinearLayout>