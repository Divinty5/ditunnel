<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiTunnel.App.ViewModels"
             xmlns:local="using:DiTunnel.App" xmlns:profiles="using:DiTunnel.Core.Profiles"
             xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
             x:Class="DiTunnel.App.Views.MainView" x:DataType="vm:MainViewModel">
  <UserControl.Resources><local:TranslationConverter x:Key="Translate"/></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#A58AFF"/><Setter Property="Foreground" Value="#181125"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.power"><Setter Property="Width" Value="140"/><Setter Property="Height" Value="140"/><Setter Property="CornerRadius" Value="70"/><Setter Property="BorderBrush" Value="#A58AFF"/><Setter Property="BorderThickness" Value="2"/></Style>
    <Style Selector="Button.power:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Style>
    <Style Selector="Button.power:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource PressedBrush}"/></Style>
    <Style Selector="Button.icon"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.icon /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.icon:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  </UserControl.Styles>
  <Grid Background="{DynamicResource PageBrush}">
    <svg:Svg x:Name="BackgroundMap" Path="/Assets/world-map.svg" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" EnableCache="True"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-01.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[0].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-02.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[1].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-03.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[2].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-04.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[3].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-05.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[4].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-06.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[5].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-07.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[6].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-08.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[7].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-09.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[8].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-10.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[9].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-11.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[10].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-12.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[11].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-13.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[12].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-14.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[13].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-15.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[14].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-16.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[15].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-17.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[16].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-18.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[17].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-19.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[18].Opacity}"/>
    <svg:Svg IsHitTestVisible="False" IsVisible="{Binding MapLightsVisible}" Path="/Assets/world-map-light-20.svg" Stretch="UniformToFill" Opacity="{Binding MapLights[19].Opacity}"/>
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,12,12,0" VerticalAlignment="Top" IsEnabled="{Binding !IsImportOpen}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Image Source="/Assets/icon.png" Width="44" Height="44"/>
            <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Di-Tunnel" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding AppVersion}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Text="{Binding Tagline, Converter={StaticResource Translate}}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          </StackPanel>
          <Button Classes="icon" Grid.Column="1" Width="44" Height="44" Padding="8" Foreground="{DynamicResource AccentTextBrush}" Click="SettingsClick" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip.Tip="Настройки"><Path Width="24" Height="24" Stretch="Uniform" Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="2.2" StrokeLineCap="Round"/></Button>
          <Button Classes="icon" Grid.Column="2" Width="44" Height="44" Padding="8" Foreground="{DynamicResource AccentTextBrush}" Click="AddClick" VerticalAlignment="Center" ToolTip.Tip="Добавить профиль"><Path Width="24" Height="24" Stretch="Uniform" Data="M12,3 L12,21 M3,12 L21,12" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="3" StrokeLineCap="Round"/></Button>
    </Grid>
    <Grid x:Name="ContentGrid" Margin="12,72,12,10" RowDefinitions="Auto,*,Auto" MaxWidth="840" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsImportOpen}">
        <Button Click="SubscriptionsClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxWidth="720" Background="{DynamicResource CardBrush}" CornerRadius="18" Padding="14,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*"><Grid Width="72" Height="48" Margin="0,0,14,0" VerticalAlignment="Center"><Image Source="{Binding SelectedFlag}" IsVisible="{Binding HasSelectedFlag}" Stretch="Uniform"/><TextBlock Text="🌐" IsVisible="{Binding !HasSelectedFlag}" FontSize="36" HorizontalAlignment="Center"/></Grid><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedSummary, Converter={StaticResource Translate}}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Text="{Binding SubscriptionLimits, Converter={StaticResource Translate}}" FontSize="12"/></StackPanel></Grid>
        </Button>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Margin="0,6">
          <Grid Width="178" Height="178"><Border Width="166" Height="166" CornerRadius="83" Background="{Binding PowerGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.Effect><BlurEffect Radius="26"/></Border.Effect></Border><Button Classes="power" Background="{DynamicResource PowerBrush}" BorderBrush="{Binding PowerBorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Command="{Binding ConnectCommand}" IsEnabled="{Binding CanConnect}" AutomationProperties.Name="{Binding PowerText, Converter={StaticResource Translate}}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <StackPanel Spacing="6"><Path Data="M11,3 L13,3 L13,13 L11,13 Z M7.76,5.76 C4.13,8.1 3.08,12.94 5.42,16.58 C7.76,20.21 12.6,21.26 16.24,18.92 C19.87,16.58 20.92,11.74 18.58,8.1 C17.98,7.17 17.18,6.39 16.24,5.79 L15.16,7.47 C17.66,9.08 18.38,12.41 16.77,14.9 C15.16,17.4 11.83,18.12 9.34,16.51 C6.84,14.9 6.12,11.57 7.73,9.08 C8.15,8.43 8.7,7.88 9.35,7.47 Z" Width="52" Height="52" Stretch="Uniform" Fill="{Binding ConnectionStateBrush}" HorizontalAlignment="Center"/><TextBlock Text="{Binding PowerText, Converter={StaticResource Translate}}" FontSize="14" HorizontalAlignment="Center" Foreground="{Binding ConnectionStateBrush}"/></StackPanel>
          </Button></Grid>
          <TextBlock Text="{Binding StatusText, Converter={StaticResource Translate}}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{Binding ConnectionStateBrush}"/>
          <TextBlock Text="{Binding ConnectionHint, Converter={StaticResource Translate}}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Foreground="{Binding ConnectionHintBrush}" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding KillSwitchText, Converter={StaticResource Translate}}" IsVisible="{Binding IsKillSwitchEnabled}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
          <Button IsVisible="{Binding HasConnectionError}" Content="{Binding CopyErrorText}" ToolTip.Tip="Копировать" Click="CopyErrorClick" Margin="0,0,8,0" Padding="12,8" FontSize="20" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
          <Border Grid.Column="1" Background="{DynamicResource NoticeBrush}" CornerRadius="12" Padding="14,10"><TextBlock Text="{Binding Notice, Converter={StaticResource Translate}}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12"/></Border>
        </Grid>
    </Grid>
    <Border Background="#D9000000" IsVisible="{Binding IsImportOpen}" PointerPressed="ImportBackdropPressed">
        <Border Margin="16" MaxWidth="520" Padding="20,18" Background="{DynamicResource CardBrush}" CornerRadius="20" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" PointerPressed="ImportCardPressed">
          <Grid>
            <StackPanel Spacing="14" IsVisible="{Binding !IsManualImportOpen}">
              <TextBlock Text="{DynamicResource Text56E1BA97A28C}" FontSize="22" FontWeight="SemiBold"/>
              <TextBlock Text="{DynamicResource TextE332303204FA}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Click="PasteClick" IsEnabled="{Binding CanImport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="132" Padding="8">
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="54" Height="54" Margin="8,0,0,0" HorizontalAlignment="Center" Stretch="Uniform" Data="M8,4 L16,4 L16,7 L20,7 L20,22 L4,22 L4,7 L8,7 Z M8,2 L16,2 L16,7 L8,7 Z M8,11 L16,11 M8,15 L16,15 M8,19 L14,19" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineCap="Round"/>
                    <TextBlock Text="{DynamicResource TextEB31594AB4F1}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Click="ScanQrClick" IsVisible="{Binding IsAndroid}" IsEnabled="{Binding CanImport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="132" Padding="8">
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="54" Height="54" HorizontalAlignment="Center" Stretch="Uniform" Data="M3,3 L10,3 L10,10 L3,10 Z M14,3 L21,3 L21,10 L14,10 Z M3,14 L10,14 L10,21 L3,21 Z M14,14 L17,14 L17,17 L14,17 Z M18,18 L21,18 L21,21 L18,21 Z M18,13 L21,13 L21,16 M13,19 L16,19 L16,22" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent"/>
                    <TextBlock Text="{DynamicResource TextB1B6DAF4FBAB}" FontSize="13" TextAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="ManualImportClick" IsEnabled="{Binding CanImport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" MinHeight="132" Padding="8">
                  <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="54" Height="54" Margin="8,0,0,0" HorizontalAlignment="Center" Stretch="Uniform" Data="M5,3 L17,3 L17,12 M5,3 L5,21 L17,21 L17,18 M8,7 L14,7 M8,11 L13,11 M8,15 L11,15 M13,17 L20,10 L22,12 L15,19 L12,20 Z" Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.8" Fill="Transparent" StrokeLineCap="Round"/>
                    <TextBlock Text="{DynamicResource Text3E17D77FCC6D}" FontSize="13" TextAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ImportMessage, Converter={StaticResource Translate}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3"/>
            </StackPanel>
            <StackPanel Spacing="10" IsVisible="{Binding IsManualImportOpen}">
              <TextBlock Text="{DynamicResource TextC2897388132C}" FontSize="22" FontWeight="SemiBold"/>
              <TextBox Text="{Binding ImportName}" PlaceholderText="{DynamicResource Text1823C14B2604}" MaxLength="100" IsEnabled="{Binding CanImport}" />
              <TextBox Text="{Binding ImportText}" PlaceholderText="{DynamicResource TextD058CCC6DADB}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" MaxHeight="260" IsEnabled="{Binding CanImport}" AutomationProperties.Name="{DynamicResource Text6BF8A742A026}"/>
              <TextBlock Text="VLESS · VMess · Trojan · Shadowsocks · Hysteria 2 · HTTPS" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ImportMessage, Converter={StaticResource Translate}}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentTextBrush}"/>
              <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3"/>
              <Button Classes="primary" Content="{DynamicResource Text848ED368817D}" Click="ManualImportSubmitClick" IsEnabled="{Binding CanImport}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
              <TextBlock Text="{Binding ImportStorageDescription, Converter={StaticResource Translate}}" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Grid>
        </Border>
    </Border>
    <Border IsVisible="{Binding IsRefreshToastVisible}" Background="#D92EBE39" CornerRadius="12" Padding="18,12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,16,16,28">
      <TextBlock Text="{Binding RefreshToast, Converter={StaticResource Translate}}" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
