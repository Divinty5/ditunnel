<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Di-Tunnel</AssemblyName>
    <Version>$(WindowsVersion)</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Svg.Controls.Skia.Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiTunnel.App\DiTunnel.App.csproj" />
    <ProjectReference Include="..\DiTunnel.Infrastructure.Xray\DiTunnel.Infrastructure.Xray.csproj" />
    <ProjectReference Include="..\DiTunnel.Platform.Windows\DiTunnel.Platform.Windows.csproj" />
    <ProjectReference Include="..\DiTunnel.NetworkHost\DiTunnel.NetworkHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\.tools\amneziawg\1\windows-x64\*" Link="Runtime\AmneziaWG\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\.tools\xray\26.3.27\windows-x64\geoip.dat" Link="Runtime\geoip.dat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\.tools\xray\26.3.27\windows-x64\geoip.dat')" />
    <Content Include="..\..\.tools\xray\26.3.27\windows-x64\geosite.dat" Link="Runtime\geosite.dat" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\.tools\xray\26.3.27\windows-x64\geosite.dat')" />
    <Content Include="..\..\.tools\xray\26.3.27\windows-x64\xray.exe" Link="Runtime\xray.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\.tools\xray\26.3.27\windows-x64\xray.exe')" />
    <Content Include="..\..\.tools\xray\26.3.27\windows-x64\wintun.dll" Link="Runtime\wintun.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\.tools\xray\26.3.27\windows-x64\wintun.dll')" />
    <Content Include="..\..\.tools\xray\26.3.27\windows-x64\LICENSE*" Link="Runtime\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyNetworkHost" AfterTargets="Build">
    <MSBuild Projects="..\DiTunnel.NetworkHost\DiTunnel.NetworkHost.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="NetworkHostAssembly" />
    </MSBuild>
    <ItemGroup>
      <NetworkHostFiles Include="@(NetworkHostAssembly);@(NetworkHostAssembly->'%(RootDir)%(Directory)Di-Tunnel.NetworkHost.exe');@(NetworkHostAssembly->'%(RootDir)%(Directory)Di-Tunnel.NetworkHost.deps.json');@(NetworkHostAssembly->'%(RootDir)%(Directory)Di-Tunnel.NetworkHost.runtimeconfig.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(NetworkHostFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNetworkHost" AfterTargets="Publish">
    <MSBuild Projects="..\DiTunnel.NetworkHost\DiTunnel.NetworkHost.csproj" Targets="Publish"
             Properties="PublishDir=$(PublishDir);Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
  </Target>
</Project>
