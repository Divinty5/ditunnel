<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>$(AndroidMinimumApiLevel).0</SupportedOSPlatformVersion>
    <LibXrayAarPath Condition="'$(LibXrayAarPath)' == '' and '$(DITUNNEL_LIBXRAY_AAR)' != ''">$(DITUNNEL_LIBXRAY_AAR)</LibXrayAarPath>
    <LibXrayAarSha256>4708A361A74F7E955635DBE3661CEFB459BDC867423C3B1826A2C5A6EA4AC77D</LibXrayAarSha256>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(LibXrayAarPath)')">
    <AndroidLibrary Include="$(LibXrayAarPath)" Bind="true" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="AndroidVersion" Value="$(AndroidVersion)" />
    <AndroidNativeLibrary Include="$(DITUNNEL_ANDROID_AWG_ROOT)\arm64-v8a\libditunnel-awg.so" Condition="Exists('$(DITUNNEL_ANDROID_AWG_ROOT)\arm64-v8a\libditunnel-awg.so')" />
    <AndroidNativeLibrary Include="$(DITUNNEL_ANDROID_AWG_ROOT)\x86_64\libditunnel-awg.so" Condition="Exists('$(DITUNNEL_ANDROID_AWG_ROOT)\x86_64\libditunnel-awg.so')" />
    <ProjectReference Include="..\DiTunnel.Core\DiTunnel.Core.csproj" />
    <ProjectReference Include="..\DiTunnel.Infrastructure.Xray\DiTunnel.Infrastructure.Xray.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AndroidAsset Include="..\..\third-party\licenses\amneziawg-*.txt" Link="licenses\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\third-party\licenses\go-*.txt" Link="licenses\%(Filename)%(Extension)" />
    <AndroidAsset Include="..\..\third-party\android-amneziawg-notices.txt" Link="licenses\android-amneziawg-notices.txt" />
  </ItemGroup>

  <Target Name="ValidateLibXrayAar" BeforeTargets="ResolveAndroidTooling">
    <Error Condition="!Exists('$(DITUNNEL_ANDROID_AWG_ROOT)\arm64-v8a\libditunnel-awg.so')" Text="Соберите Android SOCKS-мост AmneziaWG из runtime/amneziawg и задайте DITUNNEL_ANDROID_AWG_ROOT. Нативные библиотеки хранятся вне Git." />
    <Error
        Condition="!Exists('$(LibXrayAarPath)')"
        Text="libXray.aar v26.7.28 не найден. Задайте LibXrayAarPath или DITUNNEL_LIBXRAY_AAR; ожидаемый SHA-256 указан в eng/android-runtime.json." />
    <GetFileHash Files="$(LibXrayAarPath)" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="ActualLibXrayAarSha256" />
    </GetFileHash>
    <Error Condition="'$(ActualLibXrayAarSha256)' != '$(LibXrayAarSha256)'"
        Text="SHA-256 файла libXray.aar не соответствует закреплённой версии v26.7.28." />
  </Target>

</Project>
